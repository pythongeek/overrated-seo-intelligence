{
  "name": "seo-intelligence-suite",
  "version": "2.0.0",
  "description": "Industry-standard AI-powered SEO & Social Media Content Intelligence System designed to outrank TMZ-tier competitors",
  "main": "cli/seo-agent.js",
  "bin": {
    "seo-agent": "./cli/seo-agent.js",
    "competitor-research": "./cli/competitor-research.js",
    "gap-analyzer": "./cli/gap-analyzer.js",
    "social-optimizer": "./cli/social-optimizer.js"
  },
  "scripts": {
    "start": "node cli/seo-agent.js",
    "research": "node cli/competitor-research.js",
    "gap": "node cli/gap-analyzer.js",
    "social": "node cli/social-optimizer.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "lint": "eslint agents/ cli/ --fix",
    "format": "prettier --write "**/*.js" "**/*.json"",
    "docker:build": "docker build -t seo-intelligence-suite .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "node scripts/setup.js",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "seo",
    "content-intelligence",
    "competitor-analysis",
    "social-media-optimization",
    "tmz-outrank",
    "ai-content",
    "wordpress",
    "n8n",
    "google-search-console"
  ],
  "author": "Agentic Marketing Pro",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^4.3.2",
    "googleapis": "^128.0.0",
    "html-entities": "^2.4.0",
    "jsdom": "^23.0.0",
    "lodash": "^4.17.21",
    "natural": "^6.10.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^21.5.0",
    "readability": "^0.4.4",
    "winston": "^3.11.0",
    "word-count": "^0.0.4",
    "xmlrpc": "^1.3.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "agents/**/*.js",
      "!agents/**/index.js"
    ]
  }
}